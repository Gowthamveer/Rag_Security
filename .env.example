# Copy to .env and replace every example secret before running.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
UPSTREAM_URL=https://api.groq.com/openai/v1
MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=replace-with-your-groq-api-key
# Optional generic OpenAI-compatible provider key; used if GROQ_API_KEY is empty.
UPSTREAM_API_KEY=
# Optional alias for deployments that configure a single API key.
API_KEY=
MAX_UPLOAD_BYTES=10485760
GATEWAY_RATE_LIMIT=60
GATEWAY_RATE_WINDOW_SECONDS=60
